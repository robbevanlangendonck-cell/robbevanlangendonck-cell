# Kopieer dit bestand naar .env en vul je eigen sleutel in.
# .env staat in .gitignore: de sleutel komt nooit in git en nooit in de browser.
ANTHROPIC_API_KEY=sk-ant-vul-hier-je-sleutel-in

# Optioneel: een ander Claude-model dan de standaard bovenaan server.js.
# CLAUDE_MODEL=claude-opus-5-5

# Optioneel: de poort van de webserver (standaard 3000).
# PORT=3000

# Optioneel: zet op 1 als de server achter een reverse proxy draait,
# zodat de limiet van 20 berichten per minuut per bezoeker telt.
# TRUST_PROXY=1
